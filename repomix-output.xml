<file path="src/components/inbox/inbox-view.tsx">
"use client";


import { useState } from "react";
import { HugeiconsIcon } from "@hugeicons/react";
import {
  Idea01Icon,
  Task01Icon,
  StickyNote01Icon,
  Link01Icon,
  Tag01Icon,
  Add01Icon,
} from "@hugeicons/core-free-icons";
import { TopBar } from "@/components/layout/top-bar";
import { TwoPaneShell, type NavEntry } from "@/components/layout/two-pane-shell";

type FolderId = "ideas" | "tasks" | "notes" | "links" | "organize";

interface InboxItem {
  id: string;
  label: string;
  folder: FolderId;
}

const folders: NavEntry[] = [
  { id: "ideas", label: "Ideas", icon: Idea01Icon },
  { id: "tasks", label: "Unprocessed tasks", icon: Task01Icon },
  { id: "notes", label: "Notes", icon: StickyNote01Icon },
  { id: "links", label: "Links", icon: Link01Icon },
  { id: "organize", label: "To organize later", icon: Tag01Icon },
];

const seedItems: InboxItem[] = [
  { id: "1", label: "Try RRF re-ranking on the notebook retriever", folder: "ideas" },
  { id: "2", label: "Renew gym membership before the 15th", folder: "tasks" },
  { id: "3", label: "prisma.io/docs/mongodb-preview", folder: "links" },
  { id: "4", label: "Note on convolution kernels from class", folder: "notes" },
];

export default function InboxView() {
  const [items, setItems] = useState<InboxItem[]>(seedItems);
  const [activeFolder, setActiveFolder] = useState<FolderId>("ideas");
  const [draft, setDraft] = useState("");

  const counts = folders.map((f) => ({
    ...f,
    count: items.filter((i) => i.folder === (f.id as FolderId)).length,
  }));

  const visible = items.filter((i) => i.folder === activeFolder);
  const activeLabel = folders.find((f) => f.id === activeFolder)?.label ?? "";

  function capture() {
    const value = draft.trim();
    if (!value) return;
    setItems((prev) => [
      { id: crypto.randomUUID(), label: value, folder: activeFolder },
      ...prev,
    ]);
    setDraft("");
  }

  return (
    <div className="flex h-screen w-full flex-col bg-background text-foreground">
      <TopBar active="inbox" level={12} streak={4} />

      <TwoPaneShell
        navTitle="Inbox"
        entries={counts}
        activeId={activeFolder}
        onSelect={(id) => setActiveFolder(id as FolderId)}
        navFooter={
          <p className="text-[11px] leading-snug text-muted-foreground">
            Capture first, organize later.
          </p>
        }
      >
        <div className="flex items-center justify-between border-b border-border/60 px-5 py-3">
          <span className="text-sm font-medium">{activeLabel}</span>
          <span className="font-mono text-[11px] text-muted-foreground">
            {visible.length} item{visible.length === 1 ? "" : "s"}
          </span>
        </div>

        <div className="border-b border-border/40 px-5 py-3">
          <div className="flex items-center gap-2 rounded-md border border-border/60 bg-muted/10 px-3 py-2 focus-within:border-amber-400/50">
            <HugeiconsIcon icon={Add01Icon} size={15} className="shrink-0 text-muted-foreground" />
            <input
              value={draft}
              onChange={(e) => setDraft(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === "Enter") capture();
              }}
              placeholder={`Add to ${activeLabel.toLowerCase()}…`}
              className="h-5 w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground"
            />
          </div>
        </div>

        <div className="flex-1 overflow-y-auto px-2 py-1">
          {visible.length === 0 ? (
            <div className="flex h-40 flex-col items-center justify-center gap-1 text-center">
              <span className="text-sm text-muted-foreground">Nothing here yet.</span>
              <span className="text-xs text-muted-foreground/70">
                Whatever&apos;s on your mind goes here first.
              </span>
            </div>
          ) : (
            visible.map((item) => (
              <div
                key={item.id}
                className="rounded-md px-3 py-2.5 text-sm hover:bg-accent/40"
              >
                {item.label}
              </div>
            ))
          )}
        </div>
      </TwoPaneShell>
    </div>
  );
}
</file>

<file path="src/components/layout/top-bar.tsx">
"use client";

import { useEffect } from "react";
import { useRouter } from "next/navigation";
import { HugeiconsIcon } from "@hugeicons/react";
import {
  InboxIcon,
  Settings02Icon,
  Fire02Icon,
} from "@hugeicons/core-free-icons";
import { cn } from "@/lib/utils";

type Screen = "dashboard" | "inbox" | "admin";

export function TopBar({
  active,
  level = 1,
  streak = 0,
}: {
  active: Screen;
  level?: number;
  streak?: number;
}) {
  const router = useRouter();

  useEffect(() => {
    function onKeyDown(e: KeyboardEvent) {
      if (e.key === "Escape" && active !== "dashboard") {
        router.push("/dashboard");
      }
    }
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [active, router]);

  return (
    <div className="flex h-13 shrink-0 items-center justify-between border-b border-border/60 bg-background/95 px-4 backdrop-blur">
      <button
        onClick={() => router.push("/dashboard")}
        className="flex items-center gap-2.5 hover:opacity-90"
      >
        <span className="flex h-7 w-7 items-center justify-center rounded-md bg-gradient-to-br from-amber-400 to-amber-600 text-[13px] font-bold text-black">
          A
        </span>
        <span className="text-sm font-semibold tracking-[0.08em]">ASCEND</span>
        <span className="rounded border border-amber-400/30 bg-amber-400/10 px-1.5 py-0.5 font-mono text-[10px] font-medium text-amber-400">
          LV {level}
        </span>
      </button>

      <div className="flex items-center gap-3">
        <div className="flex items-center gap-1 rounded-full border border-border/60 bg-muted/20 px-2.5 py-1">
          <HugeiconsIcon icon={Fire02Icon} size={13} className="text-rose-400" />
          <span className="font-mono text-[11px] text-muted-foreground">
            {streak}d
          </span>
        </div>

        <div className="h-5 w-px bg-border/60" />

        <div className="flex items-center gap-1">
          <NavIcon
            icon={InboxIcon}
            label="Inbox"
            active={active === "inbox"}
            onClick={() => router.push("/inbox")}
          />
          <NavIcon
            icon={Settings02Icon}
            label="Admin Panel"
            active={active === "admin"}
            onClick={() => router.push("/admin")}
          />
        </div>
      </div>
    </div>
  );
}

function NavIcon({
  icon,
  label,
  active,
  onClick,
}: {
  icon: typeof InboxIcon;
  label: string;
  active: boolean;
  onClick: () => void;
}) {
  return (
    <button
      onClick={onClick}
      title={label}
      aria-label={label}
      className={cn(
        "flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent/60 hover:text-foreground",
        active && "bg-amber-400/10 text-amber-400 hover:bg-amber-400/15 hover:text-amber-400"
      )}
    >
      <HugeiconsIcon icon={icon} size={17} />
    </button>
  );
}
</file>

