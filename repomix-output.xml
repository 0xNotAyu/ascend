<file path="src/app/globals.css">
@import "tailwindcss";

/**
 * Material 3 — Dark scheme
 * Tokens derived from the M3 Design Kit "Guidance" page color roles
 * (figma.com/design/voD6I11ZFUY7ZVPkHR0vJI), seed color #6750A4.
 * Mapped onto shadcn/ui's CSS variable contract so existing shadcn
 * components (Button, Card, Dialog, etc.) pick these up automatically.
 */
:root {
  color-scheme: dark;

  /* --- Surface tiers (M3 elevation-by-tone, not shadow) --- */
  --background: 255 8% 8%; /* surface (#141218) */
  --foreground: 264 8% 90%; /* on-surface (#E6E0E9) */

  --card: 264 8% 14%; /* surface-container (#211F26) */
  --card-foreground: 264 8% 90%;

  --popover: 264 6% 17%; /* surface-container-high (#2B2930) */
  --popover-foreground: 264 8% 90%;

  --muted: 264 6% 17%; /* surface-container-high */
  --muted-foreground: 264 6% 79%; /* on-surface-variant (#CAC4D0) */

  /* --- Border / outline --- */
  --border: 264 5% 22%; /* surface-container-highest (#36343A), toned down for dividers */
  --input: 264 5% 22%;
  --ring: 264 100% 86%; /* primary (#D0BCFF) */

  /* --- Primary role (brand) --- */
  --primary: 264 100% 86%; /* primary dark (#D0BCFF) */
  --primary-foreground: 262 40% 27%; /* on-primary (#381E72) */
  --brand: 264 100% 86%;

  /* --- Secondary / accent role --- */
  --accent: 267 15% 29%; /* secondary-container (#4A4458) */
  --accent-foreground: 265 45% 89%; /* on-secondary-container (#E8DEF8) */

  /* --- Mentions reuse secondary-container --- */
  --mention: 267 15% 29%;
  --mention-foreground: 265 45% 89%;

  /* --- Semantic (harmonized to the M3 tone system, not raw CSS colors) --- */
  --success: 122 27% 68%; /* tonal green */
  --success-foreground: 122 30% 14%;
  --warning: 42 65% 68%; /* tonal amber */
  --warning-foreground: 42 40% 16%;
  --destructive: 6 71% 81%; /* M3 error dark (#F2B8B5) */
  --destructive-foreground: 6 30% 20%;

  --radius: 1rem; /* M3 "large" 16px as the base component radius */

  /* M3 shape scale, for reference/use across components */
  --shape-xs: 4px;
  --shape-sm: 8px;
  --shape-md: 12px;
  --shape-lg: 16px;
  --shape-xl: 28px;
}

/**
 * Tailwind v4: this is what actually turns --background, --border, etc.
 * into usable utilities like bg-background / border-border / text-brand.
 * Without this block, Tailwind has no idea those class names exist.
 */
@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));

  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));

  --color-popover: hsl(var(--popover));
  --color-popover-foreground: hsl(var(--popover-foreground));

  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));

  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));

  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));
  --color-brand: hsl(var(--brand));

  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));

  --color-mention: hsl(var(--mention));
  --color-mention-foreground: hsl(var(--mention-foreground));

  --color-success: hsl(var(--success));
  --color-success-foreground: hsl(var(--success-foreground));
  --color-warning: hsl(var(--warning));
  --color-warning-foreground: hsl(var(--warning-foreground));
  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));

  --radius-lg: var(--radius);
  --radius-md: calc(var(--radius) - 4px);
  --radius-sm: calc(var(--radius) - 8px);
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
    font-feature-settings: "cv11", "ss01";
  }
}
</file>

